# Copia este archivo como .env (run.py lo hace solo la primera vez).
# .env está en .gitignore: nunca subas credenciales al repositorio.

# --- Servidor local ---
# Solo escucha en tu equipo. No lo cambies a 0.0.0.0: la app no tiene cuentas.
LETSCRAWL_HOST=127.0.0.1
# Nombres extra con los que abrir la app (separados por comas). Por defecto: localhost e IPs.
LETSCRAWL_ALLOWED_HOSTS=
# Contraseña para abrir la app desde otros dispositivos de la red (sin ella, solo desde este equipo)
LETSCRAWL_PASSWORD=
LETSCRAWL_PORT=8765
# Abrir el navegador al arrancar (1/0)
LETSCRAWL_OPEN_BROWSER=1

# --- Datos ---
# Carpeta donde se guardan la base SQLite y los exportes (relativa al proyecto o absoluta).
LETSCRAWL_DATA_DIR=data

# --- Rastreo ---
LETSCRAWL_USER_AGENT=LetsCrawlit/0.3 (+auditoria-personal)
LETSCRAWL_DEFAULT_MAX_URLS=0
LETSCRAWL_MAX_URLS_LIMIT=0
LETSCRAWL_DEFAULT_DELAY=1.0
# Pausa mínima permitida entre peticiones (segundos)
LETSCRAWL_MIN_DELAY=0.2
LETSCRAWL_RENDER_TIMEOUT=20

# --- Secretos opcionales ---
# Autenticación HTTP básica para un entorno de staging tuyo (solo se envía a ese sitio).
CRAWL_AUTH_USER=
CRAWL_AUTH_PASSWORD=
# Clave de Google PageSpeed Insights (opcional). Si está vacía, la función se desactiva.
PAGESPEED_API_KEY=

# Cookies para tu propio sitio (p. ej. sesión de staging): "nombre=valor; otra=valor". Solo se envían a ese sitio.
CRAWL_COOKIES=
# Proxy HTTP opcional, p. ej. http://usuario:clave@proxy.local:8080 (se usa si activas «Proxy» en la configuración).
CRAWL_PROXY=

# Login por formulario (se usa si activas «Login por formulario»): Playwright rellena el formulario y reutiliza la sesión.
LOGIN_URL=
LOGIN_USER=
LOGIN_PASSWORD=
# Selectores CSS opcionales si los de por defecto no encuentran los campos
LOGIN_USER_SELECTOR=
LOGIN_PASSWORD_SELECTOR=
LOGIN_SUBMIT_SELECTOR=

# IA opcional para sugerir títulos/descripciones y resúmenes.
#   AI_PROVIDER=anthropic -> usa ANTHROPIC_API_KEY (o tu perfil de `ant auth login`); modelo por defecto claude-opus-5-5
#   AI_PROVIDER=ollama    -> modelo local, sin enviar nada fuera (OLLAMA_URL, AI_MODEL p. ej. llama3.1)
#   AI_PROVIDER=openai    -> usa OPENAI_API_KEY (AI_MODEL, p. ej. el modelo que tengas contratado)
#   AI_PROVIDER=gemini    -> usa GEMINI_API_KEY (AI_MODEL vacío = gemini-flash-latest; clave gratis en https://aistudio.google.com/api-keys)
#   AI_PROVIDER=groq      -> usa GROQ_API_KEY (gratis con límites; clave en https://console.groq.com/keys)
AI_PROVIDER=
AI_MODEL=
# Descomenta solo si no usas `ant auth login` (una variable vacía taparía tu perfil):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

# Copyscape (opcional) para buscar copias de tus páginas en otras webs. De pago, con tu propia cuenta.
COPYSCAPE_USER=
COPYSCAPE_KEY=

# Search Console y Analytics 4 directos (opcional). Cliente OAuth de Google Cloud de tipo «App de escritorio»
# con las APIs Search Console, Google Analytics Data y Google Analytics Admin activadas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Diccionario de ortografía compartido por el equipo (opcional): ruta a un .txt dentro de Dropbox, Google Drive u
# OneDrive. Sin esto se usa data/dictionary.txt.
# LETSCRAWL_SHARED_DICTIONARY=C:\Users\tu-usuario\Dropbox\SEO\diccionario.txt
