// Jenkins declarative pipeline stage. Needs Python 3.12 on the agent.
pipeline {
  agent any
  environment { STAGING_URL = 'https://staging.example.com/' }
  stages {
    stage('SEO check') {
      steps {
        sh '''
          git clone --depth 1 https://github.com/YOUR-USER/letscrawlit.git letscrawlit
          cd letscrawlit
          python3.12 -m venv .venv && . .venv/bin/activate
          pip install -r requirements.txt && python -m playwright install chromium
          python -m app.cli ci "$STAGING_URL" --i-own-this-site --max-urls 500 --fail-on critical,high \
            --junit seo-junit.xml --json seo-result.json --webhook "$SLACK_WEBHOOK_URL"
        '''
      }
      post { always { junit 'letscrawlit/seo-junit.xml' } }
    }
  }
}
